from collections import deque

goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

start = (1, 2, 3, 4, 0, 6, 7, 5, 8)

def bfs(start):
    queue = deque([(start, [])])
    visited = set()

    while queue:
        state, path = queue.popleft()

        if state == goal:
            return path + [state]

        if state in visited:
            continue

        visited.add(state)

        zero = state.index(0)

        moves = []

        if zero >= 3:
            moves.append(zero - 3)

        if zero < 6:
            moves.append(zero + 3)

        if zero % 3 != 0:
            moves.append(zero - 1)

        if zero % 3 != 2:
            moves.append(zero + 1)

        for m in moves:
            new_state = list(state)

            new_state[zero], new_state[m] = new_state[m], new_state[zero]

            queue.append((tuple(new_state), path + [state]))

    return None


result = bfs(start)

if result:
    print("Solution found")

    for state in result:
        print(state[:3])
        print(state[3:6])
        print(state[6:9])
        print()
else:
    print("No solution")
